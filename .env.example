# Copy to .env; existing process environment overrides this file. Never commit keys.
TMPROXY_API_KEY=
# Empty dates = no date bound. Filter by issuance date, inclusive (YYYY-MM-DD).
DATE_FROM=2024-01-01
DATE_TO=
SOURCES=vanban_chinhphu,congbao,vbpl
CONFIG_DIR=config
DATA_DIR=data
# Maximum HTML jobs per source per run; 0 = drain the queue.
MAX_PAGES=100
REQUEST_DELAY=2
REQUEST_TIMEOUT=60
REQUEST_RETRIES=3
MAX_FILE_MB=100
MAX_HTML_MB=10
RETRY_FAILED=true
# Revisit completed pages to discover updates (downloads still deduplicated).
REFRESH=false
TMPROXY_API_URL=https://tmproxy.com/api/proxy
TMPROXY_LOCATION=0
TMPROXY_ISP=0
TMPROXY_MAX_WAIT=180
USER_AGENT=LegalDocumentCollector/1.0
VBPL_PAGE_SIZE=20
# false: finish each Congbao document when one original file downloads successfully.
CONGBAO_DOWNLOAD_ALL=false

# Kiểm tra trùng với ES trước khi tải file (cùng số hiệu + cùng ngày ban hành = trùng; vẫn lưu metadata).
# Để trống SOURCE_ES_URL để tắt kiểm tra. ES nội bộ, không đi qua TMProxy.
SOURCE_ES_URL=http://10.1.10.23:9200
SOURCE_DOCUMENT_INDEX=legal-docs
# Dừng sau N văn bản trong khoảng ngày (0 = không giới hạn); dùng để chạy thử.
MAX_DOCUMENTS=0
TARGET_ES_URL=http://10.1.10.23:9200
TARGET_DOCUMENT_INDEX=legal-docs
TARGET_CHUNK_INDEX=legal-chunk-section-v2

# Ghi ES: CHỈ cụm 23, index v2. Cụm 10.1.10.10 bị cấm tuyệt đối (mã từ chối mọi URL của cụm đó).
# Chỉ ghi thật khi chạy với --write VÀ ES_WRITE_ENABLED=yes; mặc định là chạy thử, không ghi.
ES_WRITE_ENABLED=no
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
CRAWLER_BUCKET=legal-crawler

# ID văn bản của crawler: số nhỏ nhất còn trống từ giá trị này (trên toàn bộ ID cũ của v2, dưới ID data_vbpl 900000001)
CRAWLER_ID_START=10100000

# LLM Lào Cai (bóc metadata, thẩm định quan hệ). Số request song song theo giờ: 7h-22h = LLM_CCU, 22h-7h = LLM_CCU_NIGHT
LLM_BASE_URL=http://100.91.202.88:8012/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.6-35b
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_CONNECT=5
LLM_TIMEOUT_READ=30
LLM_CCU=3
LLM_CCU_NIGHT=10
LLM_NIGHT_START=22
LLM_NIGHT_END=7
NIGHTLY_AT=00:00

# Vintern OCR. PDF resolution uses OCR_PDF_SCALE, not max_px (which only affects image uploads).
OCR_API_URL=http://127.0.0.1:8000
OCR_PDF_SCALE=2.0
OCR_TIMEOUT=900
# Shared request limit across all document threads in this process.
OCR_WORKERS=2
# One verification read for a flagged page/region; evidence only, never automatic replacement.
OCR_REVIEW_RETRY=yes
OCR_REVIEW_SCALE=3.0
# Quarter/line/signature crops: render at this scale and enlarge the crop 2x.
OCR_REGION_SCALE=3.0
# Bump after changing the OCR server model/prompt at the same URL to invalidate cached reads.
OCR_CACHE_VERSION=1
